# ContribKit Environment Variables Example
# Copy this file to .env and fill in your production values.
#
# NOTE ON DJANGO_SETTINGS_MODULE: for local `python manage.py ...` commands this
# value in .env is IGNORED. manage.py calls
# os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'contribkit.settings') before
# python-decouple ever reads .env, and contribkit/settings/__init__.py then
# resolves that to the DEV settings (DEBUG=True, sqlite3, no HTTPS redirect).
# The prod module is only selected when something sets the variable before
# Python starts — i.e. contribkit_pa_wsgi.py on PythonAnywhere.

DJANGO_SETTINGS_MODULE=contribkit.settings.prod
SECRET_KEY=replace-this-with-a-long-random-secret-key-in-production
DEBUG=False
ALLOWED_HOSTS=yourusername.pythonanywhere.com,localhost,127.0.0.1

# Database Configuration (MySQL on PythonAnywhere or sqlite3)
DB_ENGINE=sqlite3
# DB_ENGINE=mysql
# DB_NAME=yourusername$contribkit
# DB_USER=yourusername
# DB_PASSWORD=your_mysql_password
# DB_HOST=yourusername.mysql.pythonanywhere-services.com
# DB_PORT=3306

# HTTPS Security Settings
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# Optional GitHub Personal Access Token (PAT) for higher rate limits (5000/hr instead of 60/hr)
# GITHUB_PAT=ghp_examplepersonalaccesstoken

# ── AI Contribution Assistant (Groq only) ──────────────────────────────────
# The `ai` app serves LLM requests from the server only. The Groq API key
# stays in this file / the environment and is NEVER exposed to the browser.
#
# Groq is the only LLM backend. OpenAI, Gemini, and Anthropic are not used.
# Keys start with gsk_. Default model: openai/gpt-oss-120b
# (llama-3.3-70b-versatile was retired by Groq on 2026-08-16).
#
# AI_GROQ_API_KEY IS REQUIRED. With it unset, POST /ai/chat/ answers
# 503 "ai_unavailable" and the router never calls Groq at all —
# `manage.py check` prints the ai.W001 warning, and `python manage.py ai_test`
# verifies the key end to end.
#
# GOTCHA 1: python-decouple reads the OS environment BEFORE .env. If a stale
# AI_GROQ_API_KEY variable exists in your shell (even empty), it overrides
# this file and the app says "not configured". Check with
# `$env:AI_GROQ_API_KEY` (PowerShell), then open a NEW terminal or run
# `Remove-Item Env:AI_GROQ_API_KEY` before starting runserver.
#
# GOTCHA 2: this file is read ONLY from the project root (next to manage.py)
# — see contribkit/settings/_env.py. Keep exactly ONE AI_GROQ_API_KEY line,
# plain UTF-8 without BOM. If the key is present but the app still says "not
# configured", run `python manage.py ai_env` — it shows exactly what Django
# reads, why, and what to fix.
AI_PROVIDERS=groq
# AI_PROVIDER=groq

# Router retries / circuit breaker around Groq
AI_PROVIDER_FALLBACK=True
AI_PROVIDER_RETRIES=2
AI_PROVIDER_RETRY_BACKOFF=0.5
AI_PROVIDER_CIRCUIT_BREAKER=True
AI_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
AI_PROVIDER_CIRCUIT_RESET_SECONDS=60

# Groq — put your gsk_ key here
AI_GROQ_API_KEY=
# AI_GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_GROQ_MODEL=openai/gpt-oss-120b
AI_GROQ_TIMEOUT=60
AI_GROQ_MAX_TOKENS=1024
AI_GROQ_TEMPERATURE=0.7
AI_GROQ_PRIORITY=10
AI_GROQ_RATE_LIMIT=0

# Chat endpoint: per-user rate limiting + history length (session-based)
AI_CHAT_RATE_LIMIT=10
AI_CHAT_RATE_WINDOW=60
AI_CHAT_MAX_MESSAGE_LENGTH=2000
AI_CHAT_HISTORY_LIMIT=12


# Google OAuth 2.0 (Sign in with Google)
# Create an OAuth 2.0 Client ID in Google Cloud Console (Web application type) and
# paste the values below. Never commit the real values to source control.
#
# In Google Cloud Console → APIs & Services → Credentials → your OAuth 2.0
# Client ID → "Authorized redirect URIs", register EVERY host you browse the
# app from. The path is always /complete/google-oauth2/ (trailing slash
# included). localhost and 127.0.0.1 are different origins to Google, so add
# both if you use both:
#
#   http://localhost:8000/complete/google-oauth2/
#   http://127.0.0.1:8000/complete/google-oauth2/
#   https://yourusername.pythonanywhere.com/complete/google-oauth2/
#
# If the URI you browse from is not listed, Google answers with
# "Error 400: redirect_uri_mismatch" instead of the consent screen.
GOOGLE_OAUTH2_CLIENT_ID=
GOOGLE_OAUTH2_CLIENT_SECRET=
